# Entity: create_embedding

main: kit: entity: create_embedding: {

  alias: field: {}

  fields: {
    data: {
      h: "Data"
      n: "data"
      r: true
      sh: "The list of embeddings generated by the model."
      t: "`$ARRAY`"
      union: {
        branches: 2
        count: 1
        depth: 3
      }
    }
    encoding_format: {
      h: "Encoding Format"
      n: "encoding_format"
      r: false
      sh: "The format to return the embeddings in."
      t: "`$STRING`"
    }
    input: {
      h: "Input"
      n: "input"
      r: true
      sh: "Input text to embed, encoded as a string or array of tokens."
      t: "`$ANY`"
      union: {
        branches: 2
        count: 1
        depth: 0
      }
    }
    model: {
      h: "Model"
      n: "model"
      r: true
      sh: "The name of the model used to generate the embedding."
      t: "`$STRING`"
    }
    object: {
      h: "Object"
      n: "object"
      r: true
      sh: "The object type, which is always \"list\"."
      t: "`$STRING`"
    }
    usage: {
      h: "Usage"
      n: "usage"
      r: true
      sh: "The usage information for the request."
      t: "`$OBJECT`"
    }
    user: {
      h: "User"
      n: "user"
      r: false
      sh: "A unique identifier representing your end-user, which can help us monitor and detect abuse."
      t: "`$STRING`"
    }
  }

  name: "create_embedding"
  op: {
    create: {
      name: "create"
      points: [
        {
          bf: [
            "encoding_format"
            "input"
            "model"
            "user"
          ]
          co: {
            id: "POST /openai/v1/embeddings"
            source: "openapi3"
            version: 2
          }
          m: "POST"
          o: "/openai/v1/embeddings"
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "openai"
            }
            {
              lit: "v1"
            }
            {
              lit: "embeddings"
            }
          ]
          t: {
            req: {
              encoding_format: "`reqdata.encoding_format`"
              input: "`reqdata.input`"
              model: "`reqdata.model`"
              user: "`reqdata.user`"
            }
            res: "`body`"
          }
        }
      ]
    }
  }



}
